# 应用配置
PORT=3000
NODE_ENV=production

# 域名配置
BASE_DOMAIN=your-domain.com
# 新增域名（多个域名用逗号分隔）
NEW_DOMAINS=example.com,www.example.com,ai.example.com

# 服务器配置
SERVER_IP=YOUR_SERVER_IP
SERVER_USER=YOUR_SERVER_USER

# AI模型API密钥
DEEPSEEK_API_KEY=sk-********************************
QWEN_API_KEY=sk-********************************
# GLM Coding Plan 订阅版（套餐专属 Key，不能用千问/平台普通 Key）
# 个人版：个人编程套餐 > 套餐概览；团队版：团队编程套餐 > 我的套餐
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_MODEL=glm-5.3
# GLM_THINKING=disabled

# MCP服务配置
# 使用内网地址调用（同服务器，更快更稳定）
MCP_BINANCE_URL=http://127.0.0.1:8080/mcp
MCP_COINGECKO_URL=http://127.0.0.1:8080/mcp-coingecko
# Crypto.com是外部服务，保持HTTPS
MCP_CRYPTO_COM_URL=https://mcp.crypto.com/market-data/mcp

# 历史记录配置
RETENTION_DAYS=30
MAX_CHAT_SIZE_MB=10

# 应用部署基础路径（与 Nginx location /crypto-ai/ 一致时填 /crypto-ai，根路径留空）
# BASE_PATH=/crypto-ai
BASE_PATH=

# 支付宝登录（OAuth 中心基础 URL，未配置时登录相关接口返回 503）
# OAUTH_CENTER_BASE_URL=https://open.example.com/oauth-center
OAUTH_CENTER_BASE_URL=
